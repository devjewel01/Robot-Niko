[Unit]
Description=Robot-Niko
Wants=network-online.target
After=network-online.target

[Service]
Environment=VIRTUAL_ENV=/home/__USER__/robotEnv
Environment=PATH=/home/__USER__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# PICOVOICE_ACCESS_KEY=... lives here, outside the repository
EnvironmentFile=/home/__USER__/robot-niko.env
ExecStart=/home/__USER__/robotEnv/bin/python -u /home/__USER__/Robot-Niko/src/main.py --project_id 'nikorobot2-d94f9' --device_model_id 'nikorobot2-d94f9-robot-2ttpg9'

WorkingDirectory=/home/__USER__/
StandardOutput=inherit
StandardError=inherit
Restart=always
User=__USER__

[Install]
WantedBy=multi-user.target
